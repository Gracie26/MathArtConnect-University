# MathArt Connect: environment template
#
# Copy to `.env.local` (git-ignored) and fill in real values.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and visible to users.
# NEVER put the Supabase service-role key or any OAuth client secret here.
#
# The app uses real Supabase Auth. Without Supabase values it still runs, but
# sign-in screens explain that accounts are not connected. No account is faked.

# Supabase › Project Settings › API Keys. Base project URL (https://<ref>.supabase.co)
# and the PUBLISHABLE key (sb_publishable_…). Never the secret / service_role
# key — the app refuses to use it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older name, still supported (used only if the line above is empty):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Social sign-in switches ("true" to enable). Google and Apple sign-in run
# through Supabase Auth; their client secrets live in the Supabase dashboard,
# never here. Only enable after completing docs/EXTERNAL_SETUP.md.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false

# Development only: use the local, device-only test backend instead of
# Supabase (accounts never leave the device; ignored in release builds).
# EXPO_PUBLIC_AUTH_BACKEND=device-dev

# Optional: force a learning topic locally (otherwise read from the database).
EXPO_PUBLIC_ACTIVE_TOPIC_ID=

# Development only: show solutions that are still pending lecturer review, so
# reviewers can check them. Ignored in release builds; learners never see them.
# EXPO_PUBLIC_REVIEWER_MODE=true

# Build-time only (read by app.config.ts, not bundled). Override store identifiers.
# APP_IOS_BUNDLE_ID=com.mathartconnect.mobile
# APP_ANDROID_PACKAGE=com.mathartconnect.mobile
# EAS_PROJECT_ID=
